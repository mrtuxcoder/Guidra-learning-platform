# GHCR images, tagged by the release or commit being deployed
BACKEND_IMAGE=ghcr.io/your-github-owner/guidra-backend:latest
FRONTEND_IMAGE=ghcr.io/your-github-owner/guidra-frontend:latest

# Docker Compose host ports
BACKEND_PORT=5000
FRONTEND_PORT=80

# Server runtime
NODE_ENV=production
PORT=5000

# Public frontend origin allowed by CORS and used for OAuth redirects
CLIENT_URL=http

# Database and authentication
MONGO_URI=mongodb://guidra-mongodb:27017/guidra
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=https://api.example.com/api/v1/auth/google/callback

# AI providers
GEMINI_API_KEY=replace-with-gemini-api-key
GROQ_API_KEY=replace-with-groq-api-key
HUGGINGFACE_TOKEN=replace-with-huggingface-token
