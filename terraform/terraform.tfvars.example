# Copy this file to terraform.tfvars and adjust values for the target environment.
# Do not commit terraform.tfvars when it contains environment-specific or sensitive values.

region              = "ap-south-1"
environment         = "production"
project_name        = "guidra"
vpc_cidr            = "10.0.0.0/16"
availability_zones  = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs = ["10.0.2.0/24", "10.0.1.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

# Set an AMI ID appropriate for the selected region.
instance_ami_id = null
instance_type   = "t3.small"

application_port        = 80
health_check_path       = "/"
domain_name             = "guidra.tech"
certificate_arn         = null
secret_name             = "guidra-prod-secret"
alarm_notification_topic_arn = null
